#!/bin/bash
# 安装回调脚本 — 可选下载 OUI 厂商识别库
set -e

if [ "${wizard_oui:-false}" = "true" ]; then
    DATA_DIR="${TRIM_PKGVAR:-/usr/local/trim/appdata/fn-wol}"
    OUI_PATH="$DATA_DIR/oui.csv"
    URL="https://standards-oui.ieee.org/oui/oui.csv"

    echo "正在下载 OUI 厂商数据库..."
    mkdir -p "$DATA_DIR"
    if curl -fLk --max-time 120 -o "$OUI_PATH" "$URL" 2>/dev/null; then
        echo "OUI 数据库下载成功（$(wc -c < "$OUI_PATH") 字节）"
    else
        echo "OUI 数据库下载失败，不影响正常使用（仅无法显示设备品牌）"
    fi
fi

exit 0
